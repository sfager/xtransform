<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Tests run on net8.0 everywhere, and on net462 as well on Windows. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net8.0;net462</TargetFrameworks>
    <IsTestProject>true</IsTestProject>
    <!-- Test method names use Method_Scenario_Expected with underscores. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- PolySharp is intentionally omitted for net462 test projects. Every src assembly also uses
       PolySharp and generates internal System.Index, System.Range, and nullable-analysis types;
       all are visible via InternalsVisibleTo. Having the test project generate the same types
       causes CS0433 ambiguity when two src assemblies define the same PolySharp type. Test code
       that needs net462 polyfills can rely on those from the src assemblies via InternalsVisibleTo,
       or use #if NET8_0_OR_GREATER guarded code. -->


</Project>
