<Project Sdk="Microsoft.NET.Sdk">

  <!--
    W3C conformance harness. The suites are not vendored: run eng/fetch-test-suites.sh
    (or .ps1) to clone the pinned commits into .testsuites/. Tests are marked
    [Category("Conformance")] and skipped when the suites are missing.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\XTransform.Xdm\XTransform.Xdm.csproj" />
    <ProjectReference Include="..\..\src\XTransform.XPath\XTransform.XPath.csproj" />
    <ProjectReference Include="..\..\src\XTransform.Xslt\XTransform.Xslt.csproj" />
    <ProjectReference Include="..\..\src\XTransform\XTransform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="known-failures\g1.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="known-failures\xslt-g3.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="known-failures\g2.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
