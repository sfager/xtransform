<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>XDM data model for XTransform: items, nodes, atomic values, sequences, NamePool, TinyTree and the XPath cast table.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- XTransform.XPath directly accesses CastTable and other internals -->
    <InternalsVisibleTo Include="XTransform.XPath" />
    <!-- XTransform.Xslt uses DiagnosticBag and other internals when reading/compiling stylesheets -->
    <InternalsVisibleTo Include="XTransform.Xslt" />
    <!-- XTransform.Serialization uses IResultReceiver and related internals for emitters / normalizer -->
    <InternalsVisibleTo Include="XTransform.Serialization" />
  </ItemGroup>

</Project>
