<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Library projects: net8.0 for modern hosts, netstandard2.0 for older hosts,
    and an explicit net462 build so .NET Framework 4.6.2-4.7.1 hosts avoid the
    netstandard facade binding problems.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0;net462</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)README.md" Pack="true" PackagePath="\" Visible="false" />
    <InternalsVisibleTo Include="XTransform.Tests" />
    <InternalsVisibleTo Include="XTransform.Conformance" />
    <InternalsVisibleTo Include="XTransform.Benchmarks" />
  </ItemGroup>

  <!-- Every public API change is recorded in PublicAPI.Unshipped.txt (RS0016/RS0017). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Polyfills for older targets: compiler attributes (nullable, init, required) and BCL types. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
    <PackageReference Include="PolySharp" PrivateAssets="all" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

</Project>
